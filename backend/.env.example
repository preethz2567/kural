# Kural Companion Backend Environment Configuration
# Add your Anthropic API Key below to activate live Claude responses.
# When empty, Kural runs safely in Mock Companion mode.

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Optional Voice Cloning External Microservice URL (e.g. Coqui XTTS on HuggingFace Space or Modal)
# VOICE_CLONING_SERVICE_URL=https://your-coqui-space.hf.space
