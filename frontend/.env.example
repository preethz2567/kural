# Kural Frontend Environment Variables
# -------------------------------------
# Copy this file to .env.local for local development.
# On Vercel, set these variables in the project's Environment Variables dashboard.

# Base URL of the Kural FastAPI backend.
# Production (Render): https://kural-7m0o.onrender.com
# Local development: leave unset (Vite dev proxy to http://127.0.0.1:8000 is used automatically)
VITE_API_BASE_URL=https://kural-7m0o.onrender.com
